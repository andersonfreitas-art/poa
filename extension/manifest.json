{
  "manifest_version": 3,
  "name": "POA - Professor Online Automático",
  "short_name": "POA",
  "version": "1.2",
  "description": "Ferramentas de automação e produtividade para professores de escolas públicas do estado do Ceará.",
  "author": "Anderson Freitas",
  "icons": {
    "16": "images/logo-16.png",
    "32": "images/logo-32.png",
    "48": "images/logo-48.png",
    "128": "images/logo-128.png"
  },
  "permissions": [
    "sidePanel",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://*.seduc.ce.gov.br/*"
  ],
  "action": {
    "default_title": "Abrir Painel POA",
    "default_icon": {
      "16": "images/logo-16.png",
      "32": "images/logo-32.png",
      "48": "images/logo-48.png",
      "128": "images/logo-128.png"
    }
  },
  "background": {
    "service_worker": "scripts/service_worker.js"
  },
  "side_panel": {
    "default_path": "pages/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://professor.seduc.ce.gov.br/avaliacao_nota*",
        "https://professor.seduc.ce.gov.br/frequencia_chamada*",
        "https://professor.seduc.ce.gov.br/relatorio_aulas_dadas*",
        "https://professor.seduc.ce.gov.br/registro_aula_item*",
        "https://sisedu.seduc.ce.gov.br/cadastrar_gabarito*"
      ],
      "js": [
        "scripts/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}